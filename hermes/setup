#!/bin/sh
# funes's hermes integration: register `funes mcp` as its MCP server, and install a plugin whose
# lifecycle hooks convert each finished turn out of hermes's SQLite store and index it, and, with a
# memory bound, publish at session boundaries. hermes edits its own config.yaml — funes drops the
# plugin and `hermes plugins enable` does the rest; the one thing funes takes out of that file is
# the hook entries an install from before the plugin put there.
set -eu

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SOURCE="$HERE/plugin"
PLUGIN=funes

FUNES="${FUNES_BIN:-funes}"

usage() {
    echo "usage: setup add [MEMORY] | setup remove" >&2
    exit 2
}

have_hermes() {
    command -v hermes >/dev/null 2>&1
}

# The directory funes drains for this agent. funes hands us its home and our id; the plugin sees
# neither, so the resolved path is written beside it.
spool_dir() {
    printf '%s/spool/%s\n' "${FUNES_HOME:-$HOME/.funes}" "${FUNES_AGENT_ID:-hermes}"
}

# Convert the sessions hermes has already recorded, so recall reaches them before the next turn.
# The plugin runs the same module inside hermes, whose runtime is Python; from a shell we need that
# interpreter, which any box running hermes has for the same reason.
seed() {
    dest=$1
    spool=$2
    db="$3/state.db"
    [ -f "$db" ] || return 0
    if command -v python3 >/dev/null 2>&1; then
        python3 "$dest/convert.py" "$db" "$spool" >/dev/null
    else
        echo "no python3 on PATH to convert your existing hermes sessions — hermes runs on it, so" \
            "this is unexpected; they will be converted as each session ends." >&2
    fi
}

# hermes's own home: where it discovers user plugins, and where an install before the plugin wrote.
# Asked of hermes, which honors `HERMES_HOME` and its profile switches; that variable, then hermes's
# default, is the fallback when hermes can't be run.
hermes_home() {
    if have_hermes && path=$(hermes config path 2>/dev/null | tail -n 1) && [ -n "$path" ]; then
        dirname "$path"
    else
        printf '%s\n' "${HERMES_HOME:-$HOME/.hermes}"
    fi
}

# hermes discovers plugins under its own home only, so funes's lives there rather than in the
# registry. The memory rides in a file the push hook reads, so the plugin stays a static file.
install_plugin() {
    dest=$1
    memory=${2:-}
    mkdir -p "$dest"
    cp "$SOURCE/plugin.yaml" "$SOURCE/__init__.py" "$SOURCE/convert.py" "$SOURCE/funes-index.sh" "$dest/"
    chmod +x "$dest/funes-index.sh"
    if [ -n "$memory" ]; then
        printf '%s\n' "$memory" >"$dest/memory"
    else
        rm -f "$dest/memory"
    fi
}

# The `hooks:` block of hermes's config.yaml as funes and hermes both write it: one event key per
# line, each hook a `- command:` item under it, a command that may fold onto deeper lines. Mode
# `commands` prints the command of every hook running one of funes's scripts, joined back onto one
# line; mode `prune` prints the whole file without those hooks, without an event they leave empty,
# and with `hooks: {}` when none remain. A block of any other shape exits 2 with nothing printed.
hooks_awk() {
    awk -v mode="$1" '
    function indent(s) { match(s, /^ */); return RLENGTH }
    function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
    function end_item(    i) {
        if (!in_item) return
        if (cmd ~ /funes-(index|push)\.sh/) { if (mode == "commands") print cmd }
        else { for (i = 1; i <= n_item; i++) ev[++n_ev] = item[i]; ev_kept++ }
        in_item = 0; n_item = 0; cmd = ""; in_cmd = 0
    }
    function end_event(    i) {
        end_item()
        if (!in_event) return
        if (ev_items == 0 || ev_kept > 0) {
            hk[++n_hk] = ev_line
            for (i = 1; i <= n_ev; i++) hk[++n_hk] = ev[i]
            hk_kept++
        }
        in_event = 0; n_ev = 0; ev_kept = 0; ev_items = 0
    }
    function end_hooks(    i) {
        end_event()
        if (!in_hooks) return
        if (mode == "prune") {
            if (hk_kept) { print hooks_line; for (i = 1; i <= n_hk; i++) print hk[i] }
            else print "hooks: {}"
        }
        in_hooks = 0; n_hk = 0; hk_kept = 0
    }
    function keep(line) {
        if (in_item) item[++n_item] = line
        else if (in_event) ev[++n_ev] = line
        else hk[++n_hk] = line
    }
    !in_hooks && /^hooks:/ {
        v = $0; sub(/^hooks:/, "", v); v = trim(v)
        if (v == "") { in_hooks = 1; hooks_line = $0; ev_indent = 0; next }
        if (v == "{}" || v == "[]" || v == "null" || v == "~") { if (mode == "prune") print; next }
        exit 2
    }
    !in_hooks { if (mode == "prune") print; next }
    /^[^ \t#]/ { end_hooks(); if (mode == "prune") print; next }
    /^[ \t]*(#|$)/ { keep($0); next }
    {
        ind = indent($0)
        if (ev_indent == 0) ev_indent = ind
        if (ind == ev_indent && $0 ~ /^ *[A-Za-z_][A-Za-z0-9_-]*:/) {
            v = $0; sub(/^ *[A-Za-z_][A-Za-z0-9_-]*:/, "", v); v = trim(v)
            if (v != "" && v != "[]" && v != "null" && v != "~") exit 2
            end_event(); in_event = 1; ev_line = $0; next
        }
        if (in_event && ind >= ev_indent && $0 ~ /^ *- /) {
            end_item(); in_item = 1; item_indent = ind; item[++n_item] = $0; ev_items++
            v = $0; sub(/^ *- /, "", v)
            if (v ~ /^command:/) { sub(/^command:/, "", v); cmd = trim(v); in_cmd = 1; key_indent = ind + 2 }
            else if (v ~ /^[A-Za-z_][A-Za-z0-9_-]*:/) { in_cmd = 0; key_indent = ind + 2 }
            else exit 2
            next
        }
        if (in_item && ind > item_indent) {
            item[++n_item] = $0
            if (ind == key_indent && $0 ~ /^ *[A-Za-z_][A-Za-z0-9_-]*:/) {
                v = $0; sub(/^ */, "", v)
                if (v ~ /^command:/) { sub(/^command:/, "", v); cmd = trim(v); in_cmd = 1 } else in_cmd = 0
            } else if (in_cmd && ind > key_indent) cmd = cmd " " trim($0)
            next
        }
        exit 2
    }
    END { if (in_hooks) end_hooks() }'
}

manual_add() {
    memory=${1:-}
    echo "  hermes plugins enable $PLUGIN"
    if [ -n "$memory" ]; then
        echo "  hermes mcp add funes --command $FUNES --args mcp $memory"
    else
        echo "  hermes mcp add funes --command $FUNES --args mcp"
    fi
}

add() {
    memory=${1:-}
    home=$(hermes_home)
    dest="$home/plugins/$PLUGIN"
    install_plugin "$dest" "$memory"

    spool=$(spool_dir)
    mkdir -p "$spool"
    printf '%s\n' "$spool" >"$dest/spool"
    # The plugin reads the store hermes keeps beside its configuration.
    printf '%s\n' "$home/state.db" >"$dest/state-db"
    seed "$dest" "$spool" "$home"

    # The plugin does the shell hooks' work now, so they go the way `remove` takes them: approvals
    # revoked and scripts deleted, which leaves their entries inert until the user drops them.
    drop_pre_plugin_install "$home"

    if ! have_hermes; then
        echo "the funes plugin is installed at $dest"
        echo "\`hermes\` isn't on PATH — once it is, run:"
        manual_add "$memory"
        return 0
    fi

    hermes plugins enable "$PLUGIN"
    # `mcp add` probes the server and then asks whether to enable its tools, cancelling on EOF.
    if [ -n "$memory" ]; then
        printf 'y\ny\n' | hermes mcp add funes --command "$FUNES" --args mcp "$memory"
        echo "installed funes into hermes — recall, per-turn indexing, and publishing to $memory. Hermes indexing is beta."
    else
        printf 'y\ny\n' | hermes mcp add funes --command "$FUNES" --args mcp
        echo "installed funes into hermes — recall and per-turn indexing, local only. Hermes indexing is beta."
    fi
}

# Run one `hermes` removal. A registration hermes has already forgotten is a success; any other
# failure keeps its diagnostics rather than claiming a partial uninstall worked. `mcp remove` asks
# before it acts, and its output is captured here, so the answer is fed rather than awaited.
forget() {
    absent=$1
    shift
    if ! out=$(printf 'y\n' | hermes "$@" 2>&1); then
        case "$out" in
        *"$absent"*) : ;;
        *)
            printf '%s\n' "$out" >&2
            exit 1
            ;;
        esac
    fi
}

# Clear an install from before the plugin: its scripts are funes's, so they go; hermes is asked to
# revoke the approvals funes wrote for them; and their entries come out of the user's config.yaml,
# which is otherwise left as it is. Entries funes cannot take out — a hooks block of a shape it
# does not know, a file it cannot write — are named instead: hermes would run them on every turn,
# against scripts that are gone.
drop_pre_plugin_install() {
    home=$1
    config="$home/config.yaml"
    if [ -f "$config" ]; then
        if commands=$(hooks_awk commands <"$config"); then
            if [ -n "$commands" ]; then
                if have_hermes; then
                    printf '%s\n' "$commands" | while IFS= read -r command; do
                        hermes hooks revoke "$command" >/dev/null 2>&1 || true
                    done
                fi
                if hooks_awk prune <"$config" >"$config.funes-tmp" && mv -f "$config.funes-tmp" "$config"; then
                    echo "removed funes's own shell hooks from $config."
                else
                    rm -f "$config.funes-tmp"
                    name_entries "$config"
                fi
            fi
        elif grep -qE 'funes-(index|push)\.sh' "$config"; then
            name_entries "$config"
        fi
    fi
    rm -f "$home/hooks/funes-index.sh" "$home/hooks/funes-push.sh" "$home/hooks/funes-sync.log"
    rmdir "$home/hooks" 2>/dev/null || true
}

name_entries() {
    echo "$1 still declares funes's own shell hooks — delete the entries whose command runs funes-index.sh or funes-push.sh (\`hermes config edit\`)." >&2
}

remove() {
    home=$(hermes_home)
    dest="$home/plugins/$PLUGIN"
    # The spool holds converted copies of hermes's own sessions, so dropping it loses nothing a
    # re-add cannot rebuild, and leaving it would have funes keep indexing an agent it no longer
    # serves.
    rm -rf "$(spool_dir)"

    if ! have_hermes; then
        rm -rf "$dest"
        drop_pre_plugin_install "$home"
        echo "\`hermes\` isn't on PATH — the plugin files were removed. Once it is, remove the registrations manually:"
        echo "  hermes plugins disable $PLUGIN"
        echo "  hermes mcp remove funes"
        return 0
    fi

    # Disabled before the files go: hermes refuses to disable a plugin it can no longer see.
    forget "is not installed or bundled" plugins disable "$PLUGIN"
    rm -rf "$dest"
    drop_pre_plugin_install "$home"
    forget "Server 'funes' not found in config" mcp remove funes
    echo "removed funes from hermes — recall registration, plugin, and hook scripts."
}

case "${1:-}" in
add)
    shift
    [ $# -le 1 ] || usage
    add "${1:-}"
    ;;
remove)
    shift
    [ $# -eq 0 ] || usage
    remove
    ;;
*) usage ;;
esac
