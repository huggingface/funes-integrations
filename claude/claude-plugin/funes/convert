#!/bin/sh
# Convert a Claude Code transcript into a funes turns file (docs/funes-jsonl.md).
#
#   convert [--indexed <rows>] <transcript.jsonl> [out.funes.jsonl]
#
# The transcript is ~/.claude/projects/<workdir>/<uuid>.jsonl, or a sub-agent's
# <uuid>/subagents/agent-<hash>.jsonl. Without an output path the turns go to stdout; with one
# they are written through a temporary file and renamed, so a reader never sees a partial file.
#
# The session id is the transcript's file stem and the harness facet is the bundle id. `<rows>` is
# what the memory holds, as `<session id> <stamp of its last indexed turn> <turn count>` lines, or
# the session id alone: a session listed there keeps the numbering it was indexed with.
#
# A turn's role says who wrote it: `user` the human (an answered question box included), `assistant`
# the model, `tool` the output of a call, and `system` Claude Code itself.
set -eu

JQ=${FUNES_JQ:-jq}
HARNESS=${FUNES_AGENT_ID:-claude}

rows=/dev/null
if [ "${1:-}" = --indexed ] && [ $# -ge 2 ]; then
    [ ! -r "$2" ] || rows=$2
    shift 2
fi
[ $# -ge 1 ] && [ $# -le 2 ] || { echo "usage: convert [--indexed <rows>] <transcript.jsonl> [out.funes.jsonl]" >&2; exit 2; }
src=$1
[ -f "$src" ] || { echo "convert: no such transcript: $src" >&2; exit 1; }

stem=$(basename -- "$src")
stem=${stem%.jsonl}

program='
# A block whose text is only whitespace is dropped; the set is Unicode White_Space.
def blank: test("[^[:space:]]") | not;
def str: if type == "string" then . else "" end;

# jq escapes DEL where serde_json, which serialized the rows funes already holds, leaves it
# literal. The difference reaches a row only through the tojson below, where the serialization is
# itself the indexed text. The even backslash run leaves text that spells out \u007f alone.
def undel: gsub("(?<!\\\\)(?<b>(?:\\\\\\\\)*)\\\\u007f"; .b + "\u007f");

def result_text:
  if type == "string" then .
  elif type == "array" then
    [ .[] | if type == "object" then (select(.type == "text") | .text | str)
            elif type == "string" then .
            else empty end ] | join("\n")
  else "" end;

def block:
  (.type | str) as $t
  | if $t == "text" then
      (.text | str) as $x | select($x | blank | not) | {block_type: "text", text: $x}
  elif $t == "thinking" then
      (.thinking | str) as $x | select($x | blank | not) | {block_type: "thinking", text: $x}
  elif $t == "tool_use" then
      {block_type: "tool_use", text: ((if has("input") then .input else {} end) | tojson | undel)}
      + (if (.name | type) == "string" then {tool_name: .name} else {} end)
      + (if (.id | type) == "string" then {tool_use_id: .id} else {} end)
  elif $t == "tool_result" then
      ((if has("content") then .content else null end) | result_text) as $x
      | select($x | blank | not)
      | {block_type: "tool_result", text: $x}
        + (if (.tool_use_id | type) == "string" then {tool_use_id: .tool_use_id} else {} end)
  else empty end;

def blocks_of:
  if type == "string" then (if blank then [] else [{block_type: "text", text: .}] end)
  elif type == "array" then [ .[] | select(type == "object") | block ]
  else [] end;

def obj: if type == "object" then . else null end;

# A user line Claude Code wrote itself: a nudge, a notification, a skill body, the compact recap, a
# message from another session, or the marker an interruption leaves. It is `system`, so funes never
# takes it for the words of the human. Claude Code flags each one but the marker, which only its
# text tells apart.
def harness_written:
  def marker: str | startswith("[Request interrupted");
  .isMeta == true or .isCompactSummary == true
  or ((.origin | obj | .kind | str) as $k | $k != "" and $k != "human")
  or (.message | obj | .content
      | if type == "string" then marker
        elif type == "array" then length > 0 and all(.[]; (obj | .type) == "text" and (.text | marker))
        else false end);

# A reply Claude Code wrote in place of the model, such as an API error or "No response requested.".
def synthetic: .isApiErrorMessage == true or (.message | obj | .model) == "<synthetic>";

# A line as {role, content}: a user or assistant message, or a message the user typed while Claude
# was working, marked `queued`. Claude Code writes that one as a queued_command attachment in prompt
# mode rather than a user line. A message from another session is queued the same way, so the
# origin must be the human one, or absent (older versions write none). Its `rendered` field is the
# system reminder that wraps the text, so only `prompt` is what they typed. A line marked `answered`
# is the result of a question box the human answered: Claude Code records the answers beside it.
def message:
  (.type | str) as $rt
  | if $rt == "user" or $rt == "assistant" then
      (.message | obj) as $msg
      | {role: (if ($rt == "user" and harness_written) or ($rt == "assistant" and synthetic) then "system"
                else ($msg.role | select(type == "string")) // $rt end),
         content: $msg.content,
         answered: ((.toolUseResult | obj | .answers | obj // {}) | length > 0)}
    elif $rt == "attachment" then
      (.attachment | obj) as $a
      | select(($a.type | str) == "queued_command" and ($a.commandMode | str) == "prompt"
               and ($a.origin == null or ($a.origin | obj | .kind | str) == "human"))
      | {role: "user", content: $a.prompt, queued: true}
    else empty end;

[ $doc | split("\n")[] | fromjson? | select(type == "object") ] as $recs
| (first($recs[] | .cwd | select(type == "string")) // null) as $cwd
# An answered question box holds the decision of the human, though Claude Code returns it as the
# tool_result of the AskUserQuestion call: it becomes their text. Any other line holding tool output
# is `tool`.
| [ $recs[] | .message | obj | .content | arrays | .[] | obj
    | select(.type == "tool_use" and .name == "AskUserQuestion") | .id | strings ] as $asked
| [ $recs[]
    | message as $m
    | ($m.content | blocks_of
       | if $m.answered then map(
           if .block_type == "tool_result" and (.tool_use_id | IN($asked[]))
           then {block_type: "text", text} else . end)
         else . end) as $blocks
    | select(($blocks | length) > 0)
    | {format: 1, session_id: $sid}
      + (if $cwd != null then {cwd: $cwd} else {} end)
      + {turn_uuid: (.uuid | str)}
      + (if (.parentUuid | type) == "string" then {parent_uuid: .parentUuid} else {} end)
      + {seq: 0,
         ts: (.timestamp | str),
         role: (if $m.role == "user" and any($blocks[]; .block_type == "tool_result") then "tool"
                else $m.role end),
         blocks: $blocks,
         harness: $harness}
      + (if $m.queued then {queued: true} else {} end)
  ] as $all
# A session the memory holds without its queued messages keeps that numbering, and never takes them.
# Its row says so: the n-th turn counted without them carries the stamp of its last indexed turn,
# where a session indexed with them has it on the n-th counted with them. With none before that
# turn the two counts agree, and the session takes them. The count without them is read first, so
# when both name a turn carrying the stamp, the session is one indexed without them. A row with no
# stamp (funes before 1.9.0), or one neither count matches, leaves them out too.
| [$all[] | select(.queued | not)] as $without
| (first($rows | split("\n")[] | split(" ") | select(.[0] == $sid)) // null) as $row
| (if $row == null then true
   elif ($row | length) != 3 then false
   else (($row[2] | tonumber) as $n
     | if $n >= 1 and ($without | length) >= $n and $without[$n - 1].ts == $row[1]
       then $without[$n - 1] == $all[$n - 1]
       else $n >= 1 and ($all | length) >= $n and $all[$n - 1].ts == $row[1] end)
   end) as $takes
| [$all[] | select($takes or (.queued | not)) | del(.queued)] as $turns
# tool_result.tool_name comes from the tool_use with the same id, whole file, last write wins, so
# every emitted turn stands alone.
| (reduce ($turns[].blocks[] | select(.block_type == "tool_use" and has("tool_use_id"))) as $b
     ({}; .[$b.tool_use_id] = $b.tool_name)) as $names
| $turns
| to_entries[]
| .value + {seq: .key}
| .blocks |= map(
    if .block_type == "tool_result" and has("tool_use_id") and ($names[.tool_use_id] // null) != null
    then {block_type, text, tool_name: $names[.tool_use_id], tool_use_id}
    else . end)
'

# The transcript is read whole, as one string, and split into lines: a line that does not parse is
# dropped the way a whole-file reader drops a partial trailing write. `--raw-input` would read it
# line by line without the string copy, but it mangles a multi-byte character that straddles its
# 4 KiB read buffer (jq 1.7.1), which a transcript hits every few hundred KB.
run() {
    "$JQ" -c -n --rawfile doc "$src" --rawfile rows "$rows" --arg sid "$stem" --arg harness "$HARNESS" "$program"
}

if [ $# -eq 2 ]; then
    # The suffix must not be `.jsonl`: one stray `.jsonl` file rejects a whole turns directory.
    tmp=$2.tmp.$$
    trap 'rm -f "$tmp"' EXIT INT TERM
    run >"$tmp"
    # Stamped with the transcript's own time, so funes drains the spool newest session first
    # rather than in the order the seed happened to convert them.
    touch -r "$src" "$tmp"
    mv -f "$tmp" "$2"
    trap - EXIT INT TERM
else
    run
fi
