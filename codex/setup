#!/bin/sh
# funes's Codex integration: register `funes mcp` as an MCP server, and install a plugin carrying
# the skill Codex lists before any tool is loaded and the hooks that index each turn and, with a
# memory bound, publish at session boundaries. Codex writes its own config.toml; funes never does.
set -eu

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# The marketplace root — the plugin itself sits at plugins/funes, where the marketplace points.
PLUGIN_ROOT="$HERE/codex-plugin"
PLUGIN_DIR="$PLUGIN_ROOT/plugins/funes"
PLUGIN_ID="funes@huggingface"
MARKETPLACE="huggingface"

# Where an install before the plugin put funes's files. Codex answers `CODEX_HOME` itself and its
# default lands in `$HOME/.codex`, which is where that install wrote too.
CODEX_DIR="${CODEX_HOME:-$HOME/.codex}"

FUNES="${FUNES_BIN:-funes}"
# funes's MCP server names funes and this agent in its Hub requests: hf-hub appends
# HF_HUB_USER_AGENT_ORIGIN to its User-Agent. The registration is static, so the agent's version,
# which the hooks add, is left out.
MCP_ENV="HF_HUB_USER_AGENT_ORIGIN=funes; agent/codex"

usage() {
    echo "usage: setup add [MEMORY] | setup remove" >&2
    exit 2
}

have_codex() {
    command -v codex >/dev/null 2>&1
}

# The directory funes drains for this agent. funes hands us its home and our id; the hook sees
# neither, so the resolved path is written beside it.
spool_dir() {
    printf '%s/spool/%s\n' "${FUNES_HOME:-$HOME/.funes}" "${FUNES_AGENT_ID:-codex}"
}

# Codex's sessions are JSONL that has to become funes's own, which needs a JSON parser; POSIX sh has
# none and Codex ships a single Rust binary, so the converter needs jq and there is nothing to
# capture without it. Refuse before touching anything rather than install an integration that can
# never index.
#
# The check is a conversion, not a version string: macOS 15 ships an `/usr/bin/jq` that reports 1.6
# while being a pre-1.7 snapshot, and a jq built without its regex engine would pass a version gate
# and then mis-split every block.
require_jq() {
    if ! command -v jq >/dev/null 2>&1; then
        echo "funes's Codex integration needs jq to convert Codex's sessions, and it is not on PATH." >&2
        echo "  macOS    already at /usr/bin/jq on 15 and newer" >&2
        echo "  Debian   sudo apt install jq" >&2
        echo "  Fedora   sudo dnf install jq" >&2
        echo "  Alpine   apk add jq" >&2
        echo "Install it, then run \`funes add codex\` again." >&2
        exit 1
    fi
    if ! "$PLUGIN_DIR/test/run.sh" >/dev/null 2>&1; then
        echo "the jq on PATH does not convert Codex's sessions the way funes reads them — run" >&2
        echo "\`$PLUGIN_DIR/test/run.sh\` to see how it differs. funes needs a stock jq 1.6 or newer." >&2
        exit 1
    fi
}

# What the local memory holds, as `<session id> <stamp of its last indexed turn>` lines: the end of
# each `funes sessions` row, walked a page at a time from the offset each page names. A funes whose
# rows carry no span (before 1.9.0), or none to ask, lists nothing.
indexed() {
    offset=0
    while [ -n "$offset" ]; do
        page=$("$FUNES" sessions --memory local --limit 200 --offset "$offset" 2>/dev/null) || return 0
        printf '%s\n' "$page" | sed -n 's/^\[[^ ]* → \([^]]*\)] .* turns \(.*\)$/\2 \1/p'
        offset=$(printf '%s\n' "$page" | sed -n 's/.* continue with --offset \([0-9]*\),.*/\1/p')
    done
}

# A rollout's last turn as `<session id> <stamp>`, converted from a copy of its first line, which
# names the session, and its last lines in the directory `$2`. A turn is made from its own line
# alone, and Codex writes only a few records after the last one.
last_turn() {
    sample="$2/${1##*/}"
    { head -n 1 "$1"; tail -n 32 "$1"; } >"$sample"
    "$PLUGIN_DIR/convert" "$sample" | tail -n 1 | jq -r '"\(.session_id) \(.ts)"'
}

# Whether a session the rows `$1` list is missing from the rows `$2`: one the memory held at the
# last walk and holds no more.
lost() {
    awk 'FILENAME == ARGV[1] { held[$1]; next } !($1 in held) { lost = 1 } END { exit !lost }' "$2" "$1"
}

# Convert the rollouts Codex has already written, so recall reaches them before the next turn. What
# the memory holds stays beside the scripts, for the next walk to tell what it lost.
#
# The walk shares the mark the hooks' sweeps keep: every rollout older than it was converted as it
# stands, by the walk that stamped it or by a sweep since. So a re-run reads the rollouts newer than
# the mark alone, and converts each unless its last turn is one the memory holds. Every rollout is
# read when there is no mark, or when a session the rows of the last walk list is gone from the
# memory (one rebuilt since). Like a sweep, the walk stamps its mark before it reads anything, and
# keeps it only when every conversion succeeded.
seed() {
    spool=$1
    sessions="$CODEX_DIR/sessions"
    [ -d "$sessions" ] || return 0
    rows="$PLUGIN_DIR/scripts/indexed"
    mark="$PLUGIN_DIR/scripts/converted"
    # `swept` is the mark of the hooks before this bundle's, which could move past a rollout whose
    # last turns were never converted. While it is there no mark is trusted, and it goes once a
    # walk has read every rollout.
    legacy="$PLUGIN_DIR/scripts/swept"
    stamp="$mark.$$"
    work=$(mktemp -d)
    trap 'rm -rf "$work" "$stamp" "$rows.new"' EXIT INT TERM
    indexed >"$rows.new"
    : >"$stamp"
    if [ -e "$mark" ] && [ ! -e "$legacy" ] && [ -f "$rows" ] && ! lost "$rows" "$rows.new"; then
        find "$sessions" -name 'rollout-*.jsonl' -newer "$mark"
    else
        find "$sessions" -name 'rollout-*.jsonl'
    fi >"$work/rollouts" || true
    mv -f "$rows.new" "$rows"
    while IFS= read -r src; do
        if [ -s "$rows" ] && grep -qxF -- "$(last_turn "$src" "$work")" "$rows"; then
            continue
        fi
        stem=${src##*/}
        "$PLUGIN_DIR/convert" "$src" "$spool/${stem%.jsonl}.funes.jsonl" || rm -f "$stamp"
    done <"$work/rollouts"
    if [ -e "$stamp" ]; then
        mv -f "$stamp" "$mark"
        rm -f "$legacy"
    fi
    rm -rf "$work"
    trap - EXIT INT TERM
}

# The plugin's hooks: a static file per binding, plus the memory in a file the push hook reads. The
# hook commands never carry the memory, so nothing has to generate JSON and this script needs no
# interpreter beyond the shell — the only thing a box running Codex is guaranteed to have.
write_hooks() {
    memory=${1:-}
    if [ -n "$memory" ]; then
        cp "$HERE/hooks-remote.json" "$PLUGIN_DIR/hooks.json"
        printf '%s\n' "$memory" >"$PLUGIN_DIR/scripts/memory"
    else
        cp "$HERE/hooks-local.json" "$PLUGIN_DIR/hooks.json"
        rm -f "$PLUGIN_DIR/scripts/memory"
    fi
}

# Clear what an install before the plugin left in Codex's own tree. The skill and the scripts are
# funes's to delete; `hooks.json` is the user's file: funes's entries come out of it, the user's
# stay, and it goes only once nothing is left. Without jq to do that, the file is left as it is,
# along with the scripts its entries still run.
drop_pre_plugin_install() {
    # `skills` is Codex's own root, so only funes's directory in it goes; the shared tree, which
    # every harness implementing the skills standard reads, is funes's own and is pruned when empty.
    rm -rf "$CODEX_DIR/skills/funes" "$HOME/.agents/skills/funes"
    rmdir "$HOME/.agents/skills" "$HOME/.agents" 2>/dev/null || true
    config="$CODEX_DIR/hooks.json"
    if [ -f "$config" ] && grep -qE 'funes-(index|push)\.sh' "$config"; then
        if ! prune_hooks "$config"; then
            echo "$config still holds funes hook entries beside your own — delete the groups whose command runs funes-index.sh or funes-push.sh." >&2
            return 0
        fi
    fi
    rm -f "$CODEX_DIR/hooks/funes-index.sh" "$CODEX_DIR/hooks/funes-push.sh" "$CODEX_DIR/hooks/funes-sync.log"
    rmdir "$CODEX_DIR/hooks" 2>/dev/null || true
}

# Take funes's entries out of a hooks file: a hook whose command runs a funes script goes, then any
# group and any event left empty, and the file itself once nothing is left. Fails, touching nothing,
# without jq or on a file jq cannot read as hooks.
prune_hooks() {
    config=$1
    command -v jq >/dev/null 2>&1 || return 1
    pruned=$(jq '
        .hooks |= ((. // {})
            | with_entries(.value |= (
                map(.hooks |= ((. // []) | map(select(((.command // "") | test("funes-(index|push)\\.sh")) | not))))
                | map(select((.hooks | length) > 0))))
            | with_entries(select((.value | length) > 0)))' "$config") || return 1
    if printf '%s\n' "$pruned" | jq -e '(.hooks | length) == 0 and (del(.hooks) | length) == 0' >/dev/null; then
        rm -f "$config"
    else
        printf '%s\n' "$pruned" >"$config.funes-tmp" && mv -f "$config.funes-tmp" "$config"
    fi
}

manual_add() {
    memory=${1:-}
    echo "  codex plugin marketplace add $PLUGIN_ROOT"
    echo "  codex plugin add $PLUGIN_ID"
    if [ -n "$memory" ]; then
        echo "  codex mcp add funes --env '$MCP_ENV' -- $FUNES mcp $memory"
    else
        echo "  codex mcp add funes --env '$MCP_ENV' -- $FUNES mcp"
    fi
}

add() {
    memory=${1:-}
    require_jq
    write_hooks "$memory"

    spool=$(spool_dir)
    mkdir -p "$spool"
    printf '%s\n' "$spool" >"$PLUGIN_DIR/scripts/spool"
    seed "$spool"

    drop_pre_plugin_install

    if ! have_codex; then
        echo "the funes plugin is installed at $PLUGIN_DIR"
        echo "\`codex\` isn't on PATH — once it is, run:"
        manual_add "$memory"
        return 0
    fi

    if ! codex plugin marketplace add "$PLUGIN_ROOT"; then
        echo "\`codex plugin\` couldn't take funes's marketplace — upgrade Codex (funes's hooks ride in a plugin), then run \`funes add codex\` again." >&2
        exit 1
    fi
    # Installing an installed plugin re-copies the source, so refreshed hooks land without a version
    # bump; `mcp add` overwrites an existing registration, so a re-run may change the memory.
    codex plugin add "$PLUGIN_ID"
    if [ -n "$memory" ]; then
        codex mcp add funes --env "$MCP_ENV" -- "$FUNES" mcp "$memory"
        echo "installed funes into Codex — recall, per-turn indexing, and publishing to $memory."
    else
        codex mcp add funes --env "$MCP_ENV" -- "$FUNES" mcp
        echo "installed funes into Codex — recall and per-turn indexing, local only."
    fi
    # Codex skips a hook until its exact command is trusted, so an install that says nothing here
    # reads as automation that silently never runs.
    echo "run \`/hooks\` in Codex to review and trust them — until then Codex skips them."
}

# Run one `codex` removal. A registration codex has already forgotten is a success; any other
# failure keeps its diagnostics rather than claiming a partial uninstall worked.
forget() {
    absent=$1
    shift
    if ! out=$(codex "$@" 2>&1); then
        case "$out" in
        *"$absent"*) : ;;
        *)
            printf '%s\n' "$out" >&2
            exit 1
            ;;
        esac
    fi
}

remove() {
    # The spool holds converted copies of Codex's own rollouts, so dropping it loses nothing a
    # re-add cannot rebuild, and leaving it would have funes keep indexing an agent it no longer
    # serves.
    rm -rf "$(spool_dir)"
    rm -f "$PLUGIN_DIR/scripts/spool" "$PLUGIN_DIR/scripts/converted" "$PLUGIN_DIR/scripts/indexed"
    drop_pre_plugin_install

    if ! have_codex; then
        echo "\`codex\` isn't on PATH — the plugin files were removed. Once it is, remove the registrations manually:"
        echo "  codex mcp remove funes"
        echo "  codex plugin remove $PLUGIN_ID"
        echo "  codex plugin marketplace remove $MARKETPLACE"
        return 0
    fi

    forget "No MCP server named 'funes' found" mcp remove funes
    codex plugin remove "$PLUGIN_ID"
    forget "is not configured or installed" plugin marketplace remove "$MARKETPLACE"
    echo "removed funes from Codex — recall registration, plugin, hooks, and skill."
}

case "${1:-}" in
add)
    shift
    [ $# -le 1 ] || usage
    add "${1:-}"
    ;;
remove)
    shift
    [ $# -eq 0 ] || usage
    remove
    ;;
*) usage ;;
esac
